# Copy this as .env for local development, but do NOT commit real secrets.
DERIV_CLIENT_ID=34VU8L3LDiaENrDGVjqQP
DERIV_REDIRECT_URI=http://localhost:8000/auth/deriv/callback
NEXORA_PUBLIC_URL=http://localhost:8000
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
NEXORA_FERNET_KEY=REPLACE_WITH_GENERATED_KEY
# For Render/Supabase use the Postgres connection string via dashboard secrets:
DATABASE_URL=sqlite:///./nexora_local.db
NEXORA_SYMBOL=1HZ100V
# Trial offer for newly authenticated Deriv users: 24 hours, begins at first login.
# Existing entitlements are never shortened by changing this variable.
NEXORA_TRIAL_HOURS=24
# Controle apenas para compras com dinheiro VIRTUAL na Deriv Demo.
# Definir true na Render para teste DEMO supervisionado depois de conferir ambiente e guardas.
# Manter false quando não houver sessão demo autorizada. Nunca habilita dinheiro real.
NEXORA_DEMO_BUY_ENABLED=false

# Stripe subscriptions — NEXORA uses prepaid, non-recurring access.
# On a public HTTPS deployment use only LIVE mode with live credentials.
# Do not add Stripe credentials to GitHub, HTML, logs or pull requests.
NEXORA_STRIPE_BILLING_ENABLED=false
NEXORA_STRIPE_MODE=test
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Two separate REAL release controls; both intentionally disabled.
# Do not set to true during CI, DEMO smoke tests or routine deployment.
NEXORA_REAL_AUTOPILOT_ENABLED=false
NEXORA_REAL_RELEASE_APPROVED=false
